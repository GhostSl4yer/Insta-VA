# Insta-VA — configuration
# Copiez ce fichier en `.env` puis adaptez les valeurs.

# Environnement : `developpement` (démo) ou `production` (données fournies)
APP_ENV=developpement

# Serveur
PORT=3000
HOST=0.0.0.0

# Dossier de persistance (base SQLite, Drive local, rapports)
DATA_DIR=data

# Fuseau horaire du compte Instagram (le cycle tourne de 16h à 00h dans ce fuseau)
IG_TIMEZONE=America/New_York

# Mode d'exécution : `simulation` (100% autonome, sans identifiants)
# ou `graph` (API Instagram Graph officielle pour la publication + insights).
INSTAGRAM_MODE=simulation

# Vitesse de l'horloge : minutes simulées par seconde réelle.
# 6 => une journée de cycle (16h→00h) dure 80 s. Mettre 1 pour un rythme proche du réel.
VITESSE_DEFAUT=6

# Nombre de jours d'historique générés au premier démarrage (démo).
AMORCAGE_JOURS=6

# Pause (ms) entre deux journées, pour rendre le cycle lisible dans l'UI.
PAUSE_INTERJOUR_MS=2200

# URL publique de l'application (nécessaire en mode graph pour servir les médias à l'API)
URL_PUBLIQUE=

# ── API Instagram Graph (mode `graph` uniquement) ──────────────
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v21.0

# ── Google Drive (optionnel, sinon Drive local dans DATA_DIR/drive) ──
GOOGLE_DRIVE_ENABLED=false
GOOGLE_ACCESS_TOKEN=
GOOGLE_DRIVE_REELS_FOLDER_ID=
GOOGLE_DRIVE_STORIES_FOLDER_ID=
GOOGLE_DRIVE_PHOTOS_FOLDER_ID=

# ── Accès à la console (production) ───────────────────────────
# En production, la console exige un mot de passe (voir .env.production.example).
INSTAVA_MOT_DE_PASSE=
INSTAVA_MOT_DE_PASSE_HASH=
INSTAVA_SECRET=
INSTAVA_SESSION_HEURES=12
INSTAVA_DERRIERE_PROXY=false
INSTAVA_HTTPS=false

# Interactions (like / commentaire / suivi) : `false` en production.
INSTAVA_INTERACTIONS=true

# ── Notifications du responsable (optionnel) ──────────────────
RAPPORT_WEBHOOK_URL=
