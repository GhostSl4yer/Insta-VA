# Déploiement sans Docker (VPS Debian/Ubuntu).
#   sudo cp deploy/insta-va.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now insta-va

[Unit]
Description=Insta-VA — console autonome du compte Instagram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=instava
Group=instava
WorkingDirectory=/opt/insta-va
EnvironmentFile=/opt/insta-va/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/main.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/insta-va/data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
