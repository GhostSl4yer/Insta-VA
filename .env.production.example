# ============================================================================
# Insta-VA — configuration de PRODUCTION
# Copiez ce fichier en `.env`, renseignez les valeurs, ne le versionnez jamais.
# ============================================================================

# ── Identité du déploiement ─────────────────────────────────────────────────
APP_ENV=production
DOMAINE=bot.exemple.com
URL_PUBLIQUE=https://bot.exemple.com
IG_TIMEZONE=Africa/Porto-Novo

# ── Serveur ─────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
DATA_DIR=data

# Derrière Caddy/Nginx : lit X-Forwarded-For et X-Forwarded-Proto.
INSTAVA_DERRIERE_PROXY=true
INSTAVA_HTTPS=true

# ── Accès à la console (obligatoire) ────────────────────────────────────────
# Soit un mot de passe en clair (simple), soit son hash scrypt (recommandé).
# Générer un hash :  node scripts/hash-mot-de-passe.js "mon mot de passe"
INSTAVA_MOT_DE_PASSE=
INSTAVA_MOT_DE_PASSE_HASH=

# Secret de signature des sessions (32 octets en hexadécimal minimum).
# Générer :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INSTAVA_SECRET=
INSTAVA_SESSION_HEURES=12

# ── Moteur ──────────────────────────────────────────────────────────────────
# 1 = rythme réel (une minute simulée par seconde réelle).
VITESSE_DEFAUT=1
# En production, l'historique n'est jamais fabriqué.
AMORCAGE_JOURS=0
PAUSE_INTERJOUR_MS=0

# Interactions (like / commentaire / suivi) : désactivées par défaut en production.
INSTAVA_INTERACTIONS=false

# ── Instagram Graph ─────────────────────────────────────────────────────────
# Peut aussi être saisi dans la console (stocké chiffré). Les valeurs ci-dessous
# servent d'amorçage au premier démarrage.
INSTAGRAM_MODE=graph
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v21.0

# ── Notifications (optionnel) ───────────────────────────────────────────────
RAPPORT_WEBHOOK_URL=
